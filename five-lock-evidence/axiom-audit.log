def DEST.IsDEST : (DEST.Carrier → DEST.Carrier → Prop) → Prop :=
fun r =>
  (∀ (a b : DEST.Carrier), (∀ (y : DEST.Carrier), DEST.mem₁ y a ↔ DEST.mem₁ y b) → a = b) ∧
    (∀ (a b : DEST.Carrier), (∀ (y : DEST.Carrier), r y a ↔ r y b) → a = b) ∧
      (∀ (p : DEST.Formula) (l : List DEST.Carrier),
          ∃ a, ∀ (y : DEST.Carrier), r y a ↔ DEST.Formula.eval DEST.M p (↑y :: List.map Subtype.val l)) ∧
        ∀ (p : DEST.Formula) (l : List DEST.Carrier),
          (∀ b ∈ l, DEST.Uniform r b) →
            ∀ (a : DEST.Carrier),
              (∀ (y : DEST.Carrier), r y a ↔ DEST.Formula.eval DEST.M p (↑y :: List.map Subtype.val l)) →
                ¬r a a → DEST.Uniform r a
